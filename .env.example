# All paths are optional — these are the repo-relative defaults.
# Point these elsewhere to run against a dataset that lives outside the repo.

# FRAUDLENS_DATA_DIR=./data/elliptic_bitcoin_dataset
# FRAUDLENS_MODELS_DIR=./models
# FRAUDLENS_ARTIFACTS_DIR=./artifacts
# FRAUDLENS_CACHE_DIR=./.cache
# FRAUDLENS_PLOTS_DIR=./notebooks

# Frontend: where the API lives. Unset means "/api" via the Vite dev proxy.
# VITE_API_BASE=http://localhost:8000/api
